@startuml
!include https://raw.githubusercontent.com/plantuml-office/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title [Component Diagram] Discord Bot Privacy Pipeline

Person(user, "Discord User")
System_Boundary(bot, "Spring Boot Application") {
    Component(listener, "DiscordCommandListener", "Presentation", "Command detection & response")
    Component(svc, "SummaryService", "Orchestration", "Main logic flow")
    Component(privacy, "PrivacyFilterService", "Security", "Pseudonymization & Restore")
    Component(gemini, "GeminiApiClient", "AI Integration", "Google Gemini REST API")
    Component(repo, "SummaryRepository", "Data Access", "JPA & MariaDB")
}

System_Ext(google, "Google Gemini API", "External LLM Service")
ContainerDb(db, "MariaDB", "Relational Database", "Encrypted storage")

Rel(user, listener, "Uses", "/정리해줘")
Rel(listener, svc, "Calls")
Rel_R(svc, privacy, "1. Pseudonymize / 3. Restore (조회 시점)")
Rel(svc, gemini, "2. Request summary")
Rel(gemini, google, "REST API")
Rel(svc, repo, "4. Save entity")
Rel(repo, db, "Auto Encrypt (AES-256)")

@enduml